|       "i{border-radius:10px / 20%}b{border-radius:1px 2px 3px / 4px 5px}u{border-radius:1em 2em;font-size:10px}s{border-top-left-radius:5px 6px;border-top-right-radius:3px 3px;border-bottom-right-radius:7%}q{border-radius:1px / 2px / 3px}q{border-top-left-radius:1px 2px 3px}"
|   <body>
|     @border-top-left-radius: 0px
|     @border-top-right-radius: 0px
|     @border-bottom-right-radius: 0px
|     @border-bottom-left-radius: 0px
|     <i>
