#data
<!DOCTYPE html><style>.dark{--x:rgb(1,2,3)}x-h{--y:4px}</style><div class=dark><x-h open><template shadowrootmode=open><style>:host([open]){color:green}:host(:not([disabled])){font-weight:700}::slotted(*){font-style:italic}::slotted([slot=prefix]){text-decoration-line:underline}:host-context(.dark) i{color:var(--x)}slot[name=suffix]::slotted(span){font-size:30px}i{letter-spacing:var(--y)}@media (min-width:1px){b{font-size:11px}}@media (max-width:1px){b{font-size:99px}}</style><i>i</i><b>b</b><slot name=prefix></slot><slot></slot><slot name=suffix></slot></template><span slot=prefix>pre</span><span>def</span><span slot=suffix>suf</span><em slot=suffix>em</em></x-h></div>
