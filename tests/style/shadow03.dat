#data
<!DOCTYPE html><style>#b { color: blue; color: light-dark(red) } @supports (color: light-dark(red)) { #c { color: red } } @supports (color: light-dark(red, green)) { #d { color: green } } #e { color-scheme: dark; color: light-dark(red, green) } #f { color: blue; color: light-dark(red, 1px) } #g { border-top: 3px solid; border-top-color: light-dark(lime, red) }</style><p id=b>b</p><p id=c>c</p><p id=d>d</p><p id=e>e</p><p id=f>f</p><p id=g>g</p>
