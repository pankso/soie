<!DOCTYPE html><style>@keyframes a{0%{color:red}100%{color:green}}@-webkit-keyframes b{from{width:10px}to{width:50px}}#x{animation:a 1s reverse forwards}#y{animation:1s b,a 2s both alternate 2}#z{animation:a 1s infinite forwards}#w{animation-name:a;animation-fill-mode:forwards;color:blue!important}#v{-webkit-animation:b .2s ease-in 1s both}#u{opacity:0;animation:none}</style><p id=x><p id=y><p id=z><p id=w><p id=v><p id=u>
