#data
<!DOCTYPE html><style>:is(.a, p){color:red}:where(i, #k) b{color:green}div{display:revert}h1{all:revert}</style><p class=a>x</p><i><b>y</b></i><div>z</div><h1>t</h1>
#errors
#properties
color,display,font-weight
#document
| <!DOCTYPE html>
| <html>
|   @color: rgb(0, 0, 0)
|   @display: block
|   @font-weight: 400
|   <head>
|     @color: rgb(0, 0, 0)
|     @display: none
|     @font-weight: 400
|     <style>
|       @color: rgb(0, 0, 0)
|       @display: none
|       @font-weight: 400
|       ":is(.a, p){color:red}:where(i, #k) b{color:green}div{display:revert}h1{all:revert}"
|   <body>
|     @color: rgb(0, 0, 0)
|     @display: block
|     @font-weight: 400
|     <p>
|       class="a"
|       @color: rgb(255, 0, 0)
|       @display: block
|       @font-weight: 400
|       "x"
|     <i>
|       @color: rgb(0, 0, 0)
|       @display: inline
|       @font-weight: 400
|       <b>
|         @color: rgb(0, 128, 0)
|         @display: inline
|         @font-weight: 700
|         "y"
|     <div>
|       @color: rgb(0, 0, 0)
|       @display: block
|       @font-weight: 400
|       "z"
|     <h1>
|       @color: rgb(0, 0, 0)
|       @display: block
|       @font-weight: 700
|       "t"

