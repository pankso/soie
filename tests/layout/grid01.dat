<!DOCTYPE html><body style="margin:0"><style>:root{--cols:[wide-start] 20px [full-start] 1fr [content-start] minmax(0,200px) [content-end] 1fr [full-end] 20px [wide-end]}.g{display:grid;grid-template-columns:var(--cols)}.g>*{grid-column:content;height:4px}.g>.w{grid-column:wide}.g>.f{grid-column:full-start/full-end}</style><div class=g><div></div><div class=w></div><div class=f></div></div>
