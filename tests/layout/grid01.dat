<!DOCTYPE html><body style="margin:0"><style>.c{display:grid;width:300px;height:100px}.c::before{content:"";grid-area:main}.e{grid-template:[main-start] 100% [main-end] / [main-start] 100% [main-end]}.r{grid-template-columns:repeat(auto-fill,[main-start] 100% [main-end]);grid-template-rows:repeat(auto-fill,[main-start] 100% [main-end])}.a{grid-template-columns:100%;grid-template-rows:100%;grid-template-areas:"main"}</style><div class="c e"></div><div class="c r"></div><div class="c a"></div>
